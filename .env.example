# Copy to .env.local. No environment configuration is required to register
# real accounts using the built-in SQLite backend on a local Node.js 24 server.

# Server-only SQLite path. Empty uses <working directory>/data/linkboard.sqlite.
# The parent directory must be writable and persistent in production.
# Docker Compose sets /app/data/linkboard.sqlite and mounts a named volume.
LINKBOARD_DATABASE_PATH=

# Final public origin (no path), for example https://links.example.com.
# Set this BEFORE the production build, especially behind a TLS reverse proxy:
# it determines canonical QR URLs, origin checks, and secure session cookies.
# Empty uses the browser/request origin, suitable for localhost development.
NEXT_PUBLIC_SITE_URL=

# Optional project path, without a trailing slash. Keep blank at a domain root.
# For https://20sha07.github.io/linkboard/ use:
# NEXT_PUBLIC_SITE_URL=https://20sha07.github.io
# NEXT_PUBLIC_BASE_PATH=/linkboard
NEXT_PUBLIC_BASE_PATH=

# npm run build:pages sets NEXT_PUBLIC_STATIC_EXPORT=true automatically.
# Do not enable static mode for a normal SQLite/server deployment.

# OPTIONAL: use Supabase instead of SQLite. Required for working accounts on
# GitHub Pages, Vercel, and Netlify. A Pages build with all three values empty
# publishes the installation guide; a partial configuration fails the build.
# First run supabase/schema.sql in the project's SQL editor.
# Keep URL and both keys empty to use SQLite in a normal server build.
# Partial Supabase configuration is an error, not a fallback to SQLite.
# Get the URL and publishable key from the Supabase project's Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternative public key variable; takes precedence over ANON_KEY if both set.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# GitHub Pages: put the URL + publishable key in repository Actions VARIABLES,
# then manually run "Deploy GitHub Pages" on main. Saving variables alone does
# not redeploy. The workflow supplies the Pages origin/base path automatically.
# https://github.com/20SHA07/linkboard/settings/variables/actions
# Supabase Site URL + allowed redirect: https://20sha07.github.io/linkboard/
# Also allow this redirect: https://20sha07.github.io/linkboard/login/
# Enable Email sign-in; configure custom SMTP for public confirmation emails.
# Full instructions: README.md, "GitHub Pages deployment".

# NEXT_PUBLIC_ values are embedded in browser JavaScript at build time.
# Use only the public anon/publishable key above. NEVER include a service-role
# key, secret key, database password, or account password in public variables.
