# Copy this file to .env.local, then restart the development server.
# Leave the Supabase URL and both key values blank for the local-only demo.
# For real accounts and shared public profiles, configure a Supabase project
# and run supabase/schema.sql in its SQL editor first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Alternatively, use the newer publishable-key name. If both key variables
# are present, NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY takes precedence.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional canonical public origin, without a trailing path.
# Set this to the final deployed URL BEFORE the production build, for example:
# NEXT_PUBLIC_SITE_URL=https://your-linkboard.example
# When omitted, sharing and QR generation use the current browser origin.
NEXT_PUBLIC_SITE_URL=

# NEXT_PUBLIC_ values are embedded in browser JavaScript at build time.
# Use only the public Supabase anon/publishable key above.
# NEVER put a service-role key, secret key, or database password in this file.
