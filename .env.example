# Run npm run configure to create a local .env. Never commit .env.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Use the publishable key (sb_publishable_...) or legacy anon key. Never service_role.
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
OWNER_EMAIL=you@example.com
SUPPORT_EMAIL=you@example.com
REGISTRATION_OPEN=true
MAX_PAGES_PER_USER=5
# Optional: configure the matching Turnstile secret in Supabase Auth first.
TURNSTILE_SITE_KEY=
