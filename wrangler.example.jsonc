{
  "name": "linkboard",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/api/*", "/p/*", "/go/*", "/robots.txt"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linkboard-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
