{
  "name": "linkboard",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/app",
      "/app/",
      "/login",
      "/signup",
      "/editor.html",
      "/report",
      "/privacy",
      "/terms",
      "/report.html",
      "/privacy.html",
      "/terms.html",
      "/api/*",
      "/p/*",
      "/go/*",
      "/robots.txt"
    ],
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "linkboard-db",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SUPABASE_URL": "https://YOUR_PROJECT.supabase.co",
    "OWNER_EMAIL": "you@example.com",
    "SUPPORT_EMAIL": "you@example.com",
    "REGISTRATION_OPEN": "true",
    "MAX_PAGES_PER_USER": "5",
    "TURNSTILE_SITE_KEY": ""
  }
}
